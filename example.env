# Neo4j authentication used when Docker initializes the database.
# Keep the password portion synchronized with NEO4J_PASSWORD below.
NEO4J_AUTH=neo4j/change_this_password

# Connection settings used by the Python import scripts.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_password

# Default source directory used when an importer receives no path argument.
FHIR_DIRECTORY_PATH=/absolute/path/to/fhir/directory